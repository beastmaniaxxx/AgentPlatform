# Docker Compose環境変数テンプレート
#
# 使い方:
#   1. このファイルを `docker/.env` としてコピーする
#   2. 各値を自分の環境に合わせて編集する
#   3. `docker/.env` はGit管理対象外です（.gitignore参照）

# --- Open WebUI ---
# ホストからOpen WebUIにアクセスするためのポート番号
OPEN_WEBUI_PORT=3000

# --- Ollama ---
# Open WebUIがOllamaに接続するためのベースURL（コンテナ名で名前解決）
OLLAMA_BASE_URL=http://ollama:11434

# --- SearXNG ---
# ホストからSearXNGにアクセスするためのポート番号
SEARXNG_PORT=8080
# SearXNGの公開ベースURL（settings.ymlのbase_url設定に使用）
SEARXNG_BASE_URL=http://localhost:8080/

# --- LM Studioモデル共有 ---
# LM Studioが管理するGGUFモデルディレクトリのホスト側パス（読み取り専用でOllamaにマウント）
# 例（Windows + WSL2、Dドライブの場合）: /mnt/d/LMStudio/models
LMSTUDIO_MODELS_PATH=/mnt/d/LMStudio/models
