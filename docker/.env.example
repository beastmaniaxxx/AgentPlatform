# Docker Compose環境変数テンプレート
#
# 使い方:
#   1. このファイルを `docker/.env` としてコピーする
#   2. 各値を自分の環境に合わせて編集する
#   3. `docker/.env` はGit管理対象外です（.gitignore参照）

# --- Open WebUI ---
# ホストからOpen WebUIにアクセスするためのポート番号
OPEN_WEBUI_PORT=3000

# --- Ollama ---
# Open WebUIがOllamaに接続するためのベースURL（コンテナ名で名前解決）
OLLAMA_BASE_URL=http://ollama:11434

# --- SearXNG ---
# ホストからSearXNGにアクセスするためのポート番号
SEARXNG_PORT=8080
# SearXNGのベースURL（settings.ymlでは未使用。`agentplatform-net`上の他コンテナ
# （後続Spec、例: web-searchのDifyワークフロー）がコンテナ名でSearXNGに到達するための値。
# `localhost`はコンテナ自身を指すため使用しないこと（docs/project_structure_proposal_v1.md参照）
SEARXNG_BASE_URL=http://searxng:8080

# --- LM Studioモデル共有 ---
# LM Studioが管理するGGUFモデルディレクトリのホスト側パス（読み取り専用でOllamaにマウント）
# 例（Windows + WSL2、Dドライブの場合）: /mnt/d/LMStudio/models
LMSTUDIO_MODELS_PATH=/mnt/d/LMStudio/models

# --- Dify全体設定 ---
# Difyの暗号化に使用する秘密鍵（32文字以上のランダム値を設定すること）
# 生成例: openssl rand -base64 42
DIFY_SECRET_KEY=

# --- Dify DB（PostgreSQL + pgvector） ---
DIFY_DB_USERNAME=postgres
DIFY_DB_PASSWORD=
DIFY_DB_DATABASE=dify

# --- Dify Redis ---
DIFY_REDIS_HOST=dify-redis
DIFY_REDIS_PORT=6379
DIFY_REDIS_PASSWORD=

# --- Dify Sandbox ---
# dify-sandbox / dify-apiが共有するAPIキー（dify-apiのCODE_EXECUTION_API_KEYと一致させること）
# 生成例: openssl rand -base64 42
DIFY_SANDBOX_API_KEY=

# --- Dify Plugin Daemon ---
# dify-plugin-daemon / dify-apiが共有する認証キー（dify-apiのPLUGIN_DAEMON_KEYと一致させること）
# 生成例: openssl rand -base64 42
DIFY_PLUGIN_DAEMON_KEY=
# dify-plugin-daemonがdify-apiの内部APIを呼び出す際のキー（dify-apiのINNER_API_KEYと一致させること）
# 生成例: openssl rand -base64 42
DIFY_PLUGIN_INNER_API_KEY=

# --- Difyホスト公開ポート ---
# ホストからDify管理画面（dify-web）にアクセスするためのポート番号
DIFY_WEB_PORT=3001
# ホストからDify API（dify-api）にアクセスするためのポート番号
DIFY_API_PORT=5001

# --- Open WebUI Pipelines ---
# ホストからPipelinesランタイムにアクセスするためのポート番号
PIPELINES_PORT=9099

# --- dify_bridge Pipeline接続設定 ---
# pipelines コンテナからDify APIに接続するためのベースURL（コンテナ名で名前解決）
DIFY_API_BASE_URL=http://dify-api:5001/v1
# 検証用ワークフロー（workflows/echo_workflow.yml）公開時に発行されるアプリAPIキー
# docs/dify-integration-setup.md の手順に従い発行後に設定する
DIFY_APP_API_KEY=

# --- web-search Pipeline接続設定 ---
# ワード検索ワークフロー（workflows/web_search.yml）公開時に発行されるアプリAPIキー
# docs/web-search-setup.md の手順に従い発行後に設定する
DIFY_WEB_SEARCH_APP_API_KEY=
# 画像検索ワークフロー（workflows/image_search.yml）公開時に発行されるアプリAPIキー
# docs/web-search-setup.md の手順に従い発行後に設定する
DIFY_IMAGE_SEARCH_APP_API_KEY=
# DifyワークフローへのHTTPリクエストタイムアウト秒数（既定: 60）
# LLMノードを含むワークフローではモデルの推論時間に応じて延長する
REQUEST_TIMEOUT_SECONDS=60
